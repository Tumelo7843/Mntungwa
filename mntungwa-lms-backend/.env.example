# ============================================================================
# Mntungwa LMS — Backend environment
#
# NEVER commit a filled-in copy of this file.
# The SERVICE_ROLE key bypasses ALL Row Level Security. It belongs only in
# Edge Function secrets and CI — never in a React app, never in a browser.
# ============================================================================

# From Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From Project Settings → Database (used by the Supabase CLI)
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_PROJECT_REF=your-project-ref

# Public site URL, used for links inside notification emails
SITE_URL=http://localhost:5173

# Optional: transactional email provider for the notification Edge Function.
# Leave unset — in-app notifications work without it and no email is sent.
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=noreply@mntungwa.co.za
